<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed so WebDAV backup can reach servers on your own network (e.g. http://192.168.x.x). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
